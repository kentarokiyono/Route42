rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function adminDoc() { return /databases/$(database)/documents/admins/$(request.auth.uid); }
    function isAdmin() { return signedIn() && exists(adminDoc()); }
    function role() { return get(adminDoc()).data.role; }
    function isOwner() { return isAdmin() && role() == 'owner'; }
    function isStaff() { return isAdmin() && role() in ['owner', 'staff']; }

    function noticeOk(d) {
      return !('notice' in d) || d.notice == null
        || (d.notice.text is string && d.notice.text.size() <= 500);
    }
    // 職員が変更できるのは混雑（スポット・道路）・お知らせのみ。モード・打ち上げ状況はオーナーのみ。
    function statusUpdateOk() {
      return noticeOk(request.resource.data) && (
        isOwner()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['spots', 'roads', 'notice', 'updatedAt']))
      );
    }

    // 職員専用（入力者名つき）
    match /live/{docId} {
      allow read: if docId == 'current' && isStaff();
      allow create: if docId == 'current' && isOwner();
      allow update: if docId == 'current' && statusUpdateOk();
      allow delete: if false;
    }

    // 一般公開（入力者名なし）
    match /public/{docId} {
      allow read: if docId == 'current';
      allow create: if docId == 'current' && isOwner();
      allow update: if docId == 'current' && statusUpdateOk();
      allow delete: if false;
    }

    // 現場報告
    match /reports/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.resolved == false;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.resolved == true;
      allow delete: if false;
    }

    // 管理者名簿。role: 'owner' | 'staff'
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update: if isOwner()
        && request.resource.data.role in ['owner', 'staff']
        && request.resource.data.name is string;
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // 入力履歴（追記のみ）
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}

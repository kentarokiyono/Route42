# ==========================================================================
# Route42 — frontend 環境変数テンプレート
# 使い方: このファイルを `.env.local` としてコピーし、<...> を実際の値に置き換える。
# NEXT_PUBLIC_ 接頭辞の変数はブラウザに配られる。service_role キーは絶対に置かないこと。
# Supabase の2つが未設定なら「デモモード」（端末のブラウザ内だけで動作）になる。
# ==========================================================================

NEXT_PUBLIC_SUPABASE_URL=<Supabase の Project URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable キー>

# 地図（Mapbox の公開トークン pk.〜。URL 制限をかけること）
NEXT_PUBLIC_MAPBOX_TOKEN=<pk.〜>

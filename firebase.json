{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "tools/**", "README.md", "**/.*", "Kinan_Apps_Wakayama_univ"],
    "rewrites": [{ "source": "/", "destination": "/Index.html" }],
    "headers": [
      { "source": "data/spots.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
      { "source": "data/route.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  }
}
